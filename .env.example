# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase configuration
VITE_SUPABASE_URL="https://kcrzmkrytjndeyzzoggw.supabase.co"
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Data Import & Online Providers Configuration
# OpenStreetMap Overpass API (Legal & Open Data ODbL, default endpoint used if empty)
OVERPASS_API_ENDPOINT="https://overpass-api.de/api/interpreter"
# Google Places API (Optional - Official Google Maps Platform Places v1)
GOOGLE_PLACES_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# Admin Security Credentials
IRAQ_ADMIN_USERNAME="admin"
IRAQ_ADMIN_PASSWORD=""
ADMIN_TOKEN_SECRET=""

# WhatsApp OTP Gateway (Optional server-side provider)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_URL=""
